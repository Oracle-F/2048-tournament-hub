GROUP_CHAT_MAX_REPLY_CHARS=240
GROUP_CHAT_TO_ME_FALLBACK_ENABLED=false
# Official QQ runtime is separately guarded and remains disabled by default.
# The runtime reads process environment only; do not commit real values here.
