BOT_CONNECTION_WATCHDOG_STALE_SECONDS=120
BOT_CONNECTION_WATCHDOG_STARTUP_GRACE_SECONDS=90
BOT_CONNECTION_WATCHDOG_RESTART_COOLDOWN_SECONDS=300
NAPCAT_TASK_NAME=
VERSE_QUERY_REPLY_CACHE_TTL_SECONDS=5
VERSE_QUERY_INFLIGHT_WAIT_TIMEOUT_SECONDS=30
EARLY_REPLAY_MAX_BYTES=5120
DISCORD_BOT_TOKEN=
DISCORD_REVIEW_CHANNEL_IDS=
