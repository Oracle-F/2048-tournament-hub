HOST=127.0.0.1
PORT=8080
LOG_LEVEL=INFO
ONEBOT_ACCESS_TOKEN=
BOT_PLATFORM=qq
GROUP_CHAT_ENABLED=false
GROUP_CHAT_WHITELIST=
