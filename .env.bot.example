OFFICIAL_QQ_APP_ID=
OFFICIAL_QQ_APP_SECRET=
OFFICIAL_QQ_BOT_SANDBOX=true
OFFICIAL_QQ_BOT_PRODUCTION_CONFIRMED=false
OFFICIAL_QQ_DATABASE_PATH=
OFFICIAL_QQ_HTTP_TIMEOUT_SECONDS=5
# In-process daily delivery starts only after the official gateway is ready.
OFFICIAL_QQ_STARS_CUP_SCHEDULE_ENABLED=false
OFFICIAL_QQ_STARS_CUP_GROUP_OPENID=
OFFICIAL_QQ_STARS_CUP_SEND_TIME=09:00
OFFICIAL_QQ_STARS_CUP_POLL_SECONDS=30
OFFICIAL_QQ_STARS_CUP_RETRY_SECONDS=900
BOT_MESSAGE_FILE_API_TIMEOUT_SECONDS=1.5
BOT_ATTACHMENT_DOWNLOAD_MAX_BYTES=26214400
BOT_PRIVATE_DEBUG_LOG_ENABLED=false
BOT_GROUP_DEBUG_LOG_ENABLED=false
BOT_SUBMIT_SCORE_ENABLED=false
BOT_CONNECTION_STATE_PATH=data/tmp/bot_connection_state.json
NAPCAT_RUNTIME_LOG_PATH=data/tmp/napcat_runtime.log
NAPCAT_RUNTIME_LOG_TAIL_LINES=80
NAPCAT_RUNTIME_LOG_TAIL_BYTES=65536
BOT_CONNECTION_ALERT_SCRIPT=scripts/show_bot_connection_alert.ps1
BOT_CONNECTION_WATCHDOG_ATTENTION_RESTART_COUNT=2
