# Copy to /etc/2048-event/official-qq-bot.env on the deployment host.
# Keep the installed file out of Git, owned by root:eventbot, and mode 0640.
# Fill credentials/OpenIDs only on the host.  Safe defaults keep all network
# and scheduled-send behavior disabled.

OFFICIAL_QQ_BOT_ENABLED=false
OFFICIAL_QQ_APP_ID=
OFFICIAL_QQ_APP_SECRET=
OFFICIAL_QQ_BOT_SANDBOX=true
OFFICIAL_QQ_BOT_PRODUCTION_CONFIRMED=false
OFFICIAL_QQ_DATABASE_PATH=/opt/2048-event/赛事中台/data/tournament_hub.sqlite3
OFFICIAL_QQ_HTTP_TIMEOUT_SECONDS=5
OFFICIAL_QQ_LOG_LEVEL=INFO

OFFICIAL_QQ_STARS_CUP_SCHEDULE_ENABLED=false
OFFICIAL_QQ_STARS_CUP_GROUP_OPENID=
OFFICIAL_QQ_STARS_CUP_SEND_TIME=09:00
OFFICIAL_QQ_STARS_CUP_POLL_SECONDS=30
OFFICIAL_QQ_STARS_CUP_RETRY_SECONDS=900
OFFICIAL_QQ_STARS_CUP_RELATIONSHIP_STATE_PATH=/opt/2048-event/赛事中台/data/tmp/stars_cup_bot/official_target_relationship.json
