[Unit]
Description=2048Event official QQ Bot
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=eventbot
Group=eventbot
WorkingDirectory=/opt/2048-event/赛事中台
EnvironmentFile=/etc/2048-event/official-qq-bot.env
ExecStartPre=/opt/2048-event/赛事中台/.venv/bin/python scripts/run_official_qq_bot.py --preflight
ExecStart=/opt/2048-event/赛事中台/.venv/bin/python scripts/run_official_qq_bot.py --start
Restart=always
RestartSec=15
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/opt/2048-event/赛事中台/data /opt/2048-event/比赛导出

[Install]
WantedBy=multi-user.target
