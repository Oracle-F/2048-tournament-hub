  {
    "name": "persistent offline state triggers an attention notice after repeated restarts",
    "description": "验证 bot 持续不在线时，先走自动重启，重复异常后再进入提醒分支，并且提醒有冷却。",
    "input": {
      "target": "bot.connection_attention_flow",
      "args": {
        "path": "data/tmp/tests/bot_connection_attention_case1.json",
        "stale_seconds": 60,
        "startup_grace_seconds": 30,
        "restart_cooldown_seconds": 300,
        "attention_restart_count": 2,
        "attention_cooldown_seconds": 900,
        "steps": [
          {
            "op": "start",
            "now": "2026-06-06T10:00:00+08:00"
          },
          {
            "op": "meta",
            "meta_event_type": "lifecycle",
            "sub_type": "connect",
            "self_id": "10001",
            "now": "2026-06-06T10:00:05+08:00"
          },
          {
            "op": "meta",
            "meta_event_type": "lifecycle",
            "sub_type": "disconnect",
            "self_id": "10001",
            "now": "2026-06-06T10:00:10+08:00"
          },
          {
            "op": "summary",
            "now": "2026-06-06T10:03:00+08:00"
          },
          {
            "op": "should_restart",
            "now": "2026-06-06T10:03:00+08:00"
          },
          {
            "op": "restart",
            "reason": "stale",
            "now": "2026-06-06T10:03:10+08:00"
          },
          {
            "op": "should_notice",
            "now": "2026-06-06T10:03:10+08:00"
          },
          {
            "op": "restart",
            "reason": "stale",
            "now": "2026-06-06T10:08:20+08:00"
          },
          {
            "op": "should_notice",
            "now": "2026-06-06T10:08:30+08:00"
          },
          {
            "op": "notice",
            "reason": "persistent_offline",
            "now": "2026-06-06T10:08:40+08:00"
          },
          {
            "op": "should_notice",
            "now": "2026-06-06T10:10:00+08:00"
          }
        ]
      }
    },
    "expected": {
      "outputs": [
        {
          "op": "start",
          "status": "starting"
        },
        {
          "op": "meta",
          "status": "online",
          "meta_event_type": "lifecycle",
          "meta_event_sub_type": "connect"
        },
        {
          "op": "meta",
          "status": "offline",
          "meta_event_type": "lifecycle",
          "meta_event_sub_type": "disconnect"
        },
        {
          "op": "summary",
          "summary": {
            "present": true,
            "stale": true,
            "reason": "stale",
            "status": "offline",
            "age_seconds": 170,
            "boot_age_seconds": 180
          }
        },
        {
          "op": "should_restart",
          "decision": {
            "restart_required": true,
            "reason": "stale",
            "summary": {
              "present": true,
              "stale": true,
              "reason": "stale",
              "status": "offline",
              "age_seconds": 170,
              "boot_age_seconds": 180
            }
          }
        },
        {
          "op": "restart",
          "status": "restarting",
          "restart_count": 1,
          "last_restart_reason": "stale"
        },
        {
          "op": "should_notice",
          "decision": {
            "attention_required": false,
            "reason": "attention_restart_threshold",
            "summary": {
              "present": true,
              "stale": true,
              "reason": "stale",
              "status": "restarting",
              "age_seconds": 180,
              "boot_age_seconds": 190
            },
            "restart_count": 1
          }
        },
        {
          "op": "restart",
          "status": "restarting",
          "restart_count": 2,
          "last_restart_reason": "stale"
        },
        {
          "op": "should_notice",
          "decision": {
            "attention_required": true,
            "reason": "persistent_offline",
            "summary": {
              "present": true,
              "stale": true,
              "reason": "stale",
              "status": "restarting",
              "age_seconds": 500,
              "boot_age_seconds": 510
            },
            "restart_count": 2
          }
        },
        {
          "op": "notice",
          "attention_count": 1,
