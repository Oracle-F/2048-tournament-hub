[
  {
    "name": "plain offline log stays silent before the restart threshold",
    "description": "验证只有账号状态变更为离线时，不会因为普通离线日志直接弹窗。真正的提醒仍然交给重启阈值和硬告警规则。",
    "input": {
      "target": "bot.connection_attention_flow",
      "args": {
        "path": "data/tmp/tests/bot_connection_attention_case_plain_offline.json",
        "runtime_log_path": "data/tmp/tests/napcat_runtime_plain_offline.log",
        "stale_seconds": 60,
        "startup_grace_seconds": 30,
        "restart_cooldown_seconds": 300,
        "attention_restart_count": 2,
        "attention_cooldown_seconds": 900,
        "steps": [
          {
            "op": "start",
            "now": "2026-06-06T10:00:00+08:00"
          },
          {
            "op": "meta",
            "meta_event_type": "lifecycle",
            "sub_type": "connect",
            "self_id": "10001",
            "now": "2026-06-06T10:00:05+08:00"
          },
          {
            "op": "meta",
            "meta_event_type": "lifecycle",
            "sub_type": "disconnect",
            "self_id": "10001",
            "now": "2026-06-06T10:00:10+08:00"
          },
          {
            "op": "log_write",
            "text": "06-07 22:41:49 [info] maomaoBot | 账号状态变更为离线\n"
          },
          {
            "op": "should_notice",
            "now": "2026-06-06T10:03:00+08:00"
          }
        ]
      }
    },
    "expected": {
      "outputs": [
        {
          "op": "start",
          "status": "starting"
        },
        {
          "op": "meta",
          "status": "online",
          "meta_event_type": "lifecycle",
          "meta_event_sub_type": "connect"
        },
        {
          "op": "meta",
          "status": "offline",
          "meta_event_type": "lifecycle",
          "meta_event_sub_type": "disconnect"
        },
        {
          "op": "log_write",
          "path": "{{PROJECT_ROOT_PATH}}{{PATH_SEPARATOR}}data{{PATH_SEPARATOR}}tmp{{PATH_SEPARATOR}}tests{{PATH_SEPARATOR}}napcat_runtime_plain_offline.log",
          "line_count": 1
        },
        {
          "op": "should_notice",
          "decision": {
            "attention_required": false,
            "reason": "attention_restart_threshold",
            "summary": {
              "present": true,
              "stale": true,
              "reason": "stale",
              "status": "offline",
              "age_seconds": 170,
              "boot_age_seconds": 180
            },
            "restart_count": 0
          }
        }
      ]
    }
  },
  {
